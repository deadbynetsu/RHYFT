FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8787 \
    TRUST_PROXY=1 \
    NETLIFY_DEV=false

WORKDIR /app

COPY --chown=node:node web-server.cjs ./web-server.cjs
COPY --chown=node:node site ./site
COPY --chown=node:node netlify/functions ./netlify/functions

USER node
EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=6s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.PORT || '8787') + '/health', {signal: AbortSignal.timeout(5000)}).then(response => {if (!response.ok) process.exit(1)}).catch(() => process.exit(1))"

CMD ["node", "web-server.cjs"]
