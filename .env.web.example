# Copy to .env.web on your own machine, then fill existing Google Web credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional shared Spotify app; personal Client IDs remain available in the UI.
SPOTIFY_CLIENT_ID=

# iniciar-web.cmd generates and reuses a local secret without displaying it.
# Environment variables set by that launcher take precedence over this file.
SESSION_SECRET=
HOST=127.0.0.1
PORT=8787
SITE_URL=http://127.0.0.1:8787
NETLIFY_DEV=true
TRUST_PROXY=0
